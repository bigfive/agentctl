#!/usr/bin/env python3
"""Stand-in for the codex binary: supports 'queue' and 'exec'."""
import json, os, sys, uuid, time

args = sys.argv[1:]
record = os.environ.get("FAKE_CODEX_QUEUE_LOG", "/tmp/fake-codex-queue.log")

if args[:2] == ["app-server", "proxy"]:
    if os.environ.get("FAKE_CODEX_PROXY_FAIL"):
        sys.stderr.write("control socket does not exist\n")
        sys.exit(1)
    for line in sys.stdin:
        request = json.loads(line)
        if request.get("method") == "initialize":
            print(json.dumps({"id": request["id"], "result": {}}), flush=True)
        elif request.get("method") == "thread/read":
            if os.environ.get("FAKE_CODEX_PREFLIGHT_FAIL"):
                print(json.dumps({"id": request["id"], "error": {"message": "thread not found"}}), flush=True)
            else:
                print(json.dumps({"id": request["id"], "result": {"thread": {"id": request["params"]["threadId"]}}}), flush=True)
    sys.exit(0)

if args and args[0] == "queue":
    if "--help" in args:
        print("Usage: codex queue --thread <THREAD> --message <TEXT>")
        sys.exit(0)
    thread = args[args.index("--thread") + 1]
    message = args[args.index("--message") + 1]
    if os.environ.get("FAKE_CODEX_QUEUE_FAIL"):
        sys.stderr.write("thread not found\n")
        sys.exit(1)
    with open(record, "a") as handle:
        handle.write(json.dumps({"thread": thread, "message": message}) + "\n")
    print("Queued message %s" % uuid.uuid4())
    sys.exit(0)

if args and args[0] == "exec":
    thread_id = args[2] if len(args) > 2 and args[1] == "resume" else str(uuid.uuid4())
    out = None
    if "-o" in args:
        out = args[args.index("-o") + 1]
    prompt = sys.stdin.read()
    print(json.dumps({"type": "thread.started", "thread_id": thread_id}),
          flush=True)
    print(json.dumps({"type": "turn.started"}), flush=True)
    if "SLOW" in prompt:
        time.sleep(30)
    if "FAIL" in prompt:
        print(json.dumps({"type": "turn.failed",
                          "error": {"message": "out of credits"}}), flush=True)
        sys.exit(1)
    if out:
        with open(out, "w") as handle:
            handle.write("codex handled: %s" % prompt.strip())
    print(json.dumps({"type": "turn.completed"}), flush=True)
    sys.exit(0)

sys.stderr.write("fake-codex: unsupported args %r\n" % args)
sys.exit(2)
