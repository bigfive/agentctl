#!/bin/sh
set -eu
target=$0
while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
        /*) target=$link ;;
        *) target=$(dirname "$target")/$link ;;
    esac
done
here=$(cd "$(dirname "$target")/.." && pwd)
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "${AGENTCTL_PYTHON:-python3}" -m agentctl_team.cli "$@"
